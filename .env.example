# App Environment Variables Example
# Duplicate this file as .env and fill in the values

# Node Environment
NODE_ENV=production
PORT=3000

# Firebase Frontend Configuration
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Gemini API Key (Required for AI Features)
# Get this from Google AI Studio: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=

# Google Service Account (Mandatory for Google Drive features)
# You can get this from Google Cloud Console -> IAM & Admin -> Service Accounts
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----"

# Google Drive Folder ID
GOOGLE_DRIVE_FOLDER_ID=

# Email Notification Settings (SMTP)
# Use a Gmail account or any other SMTP provider. If using Gmail, generate an App Password.
SMTP_USER=
SMTP_PASS=

# Sentry Configuration (Optional)
# DSN for Sentry project to capture errors
VITE_SENTRY_DSN=